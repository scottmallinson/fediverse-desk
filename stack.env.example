# Copy to stack.env next to docker-compose.yml. Container Manager reads it as
# the project's environment file. Keep it out of git: .gitignore already does.

GHOST_URL=https://example.com

# Owner or Administrator staff access token, as <id>:<hex secret>.
# This is full admin access to the site. Treat the file as a secret.
GHOST_STAFF_ACCESS_TOKEN=

# The address clients will use. Must match what the tunnel or reverse proxy
# serves, or OAuth redirects and nodeinfo will point somewhere wrong. On a VPS
# this is https:// plus the DESK_DOMAIN set in caddy.env.
SHIM_PUBLIC_URL=https://desk.example.com

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIM_PASSWORD=
