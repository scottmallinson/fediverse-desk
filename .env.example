# Ghost site, no trailing slash.
GHOST_URL=https://scottmallinson.com

# Staff access token from Ghost Admin > your profile. Format is <id>:<hex secret>.
# The user must hold the Owner or Administrator role: the identity endpoint that
# bootstraps social web auth is not reachable by any lower role, and a custom
# integration's Admin API key cannot reach it at all.
#
# This token is full admin access to the site. Treat it as the site password.
GHOST_STAFF_ACCESS_TOKEN=

# Where the queue, OAuth apps and shim tokens are persisted.
DESK_DATA_DIR=./data

# Transport for the scheduler: "ghst" shells out to @tryghost/ghst, "direct"
# talks to the API itself. The shim always uses "direct".
DESK_TRANSPORT=ghst

# --- Mastodon shim only ---

# Bind address. Loopback by default, deliberately. Only widen this if you
# understand that the shim is an authenticated write endpoint for your
# publication.
SHIM_HOST=127.0.0.1
SHIM_PORT=4040

# Public origin the shim is reachable at, as clients will see it. Must be https
# in front of any real client, because OAuth redirects run through it.
SHIM_PUBLIC_URL=http://127.0.0.1:4040

# The single password that authorises the OAuth login. Long and random.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIM_PASSWORD=

# --- MCP server only ---

# What a connected AI client may change. "off" is read-only. "queue" lets it
# draft notes and replies into the queue, where they wait before publishing.
# "direct" also lets it post, reply, like, repost and follow immediately.
# Post text is written by strangers and can ask for things: start with "off".
DESK_MCP_WRITE=off
