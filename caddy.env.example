# Copy to caddy.env next to docker-compose.yml. Read by the Caddy container
# only, which is why it is separate from stack.env: nothing here is a secret,
# and the proxy never sees the staff access token.

# The subdomain clients will use. Must match SHIM_PUBLIC_URL in stack.env, and
# must already resolve to this VPS before Caddy first starts, or the
# certificate request fails.
DESK_DOMAIN=desk.example.com

# Where Let's Encrypt sends expiry warnings if renewal stops working.
ACME_EMAIL=you@example.com
