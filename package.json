{
  "name": "fediverse-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A personal desk for a Ghost publication's Fediverse handle: a scheduler and a Mastodon-compatible shim over Ghost's private ActivityPub API.",
  "homepage": "https://github.com/scottmallinson/fediverse-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottmallinson/fediverse-desk.git"
  },
  "bugs": {
    "url": "https://github.com/scottmallinson/fediverse-desk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "desk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
